{
  "name": "@csmi/specification-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:spec": "node scripts/sync-spec.mjs && ASTRO_TELEMETRY_DISABLED=1 astro sync --force",
    "dev": "npm run sync:spec && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "npm run sync:spec && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "npm run sync:spec && ASTRO_TELEMETRY_DISABLED=1 astro check",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.2",
    "astro": "7.2.10",
    "sharp": "0.35.4",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
